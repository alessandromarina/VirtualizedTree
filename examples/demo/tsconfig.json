{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "isolatedModules": true
  },
  "include": ["src", "../../core", "../../mui", "../../vanilla", "../../tailwind", "../../css-modules", "../../styled"]
}
